# =============================================================================
# ollama.service — Penelope: Agent in a Box
# Manages the Ollama inference server (Phi-3.5-mini + nomic-embed-text).
# Must start before hermes-agent. PocketBase has no dependency on Ollama.
#
# Install:
#   sudo cp ollama.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable ollama
#   sudo systemctl start ollama
# =============================================================================

[Unit]
Description=Penelope Ollama — Local Model Inference Server
Documentation=https://ollama.com
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi
Group=pi
Environment=HOME=/home/pi
Environment=OLLAMA_HOST=0.0.0.0:11434
Environment=OLLAMA_MODELS=/home/pi/.ollama/models

ExecStart=/usr/local/bin/ollama serve

# Wait for Ollama to be healthy before marking service as started
ExecStartPost=/bin/bash -c '\
    for i in $(seq 1 30); do \
        curl -sf http://localhost:11434/api/tags >/dev/null 2>&1 && exit 0; \
        sleep 2; \
    done; \
    echo "Ollama did not become healthy in time" >&2; exit 1'

Restart=always
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ollama

# Phi-3.5-mini needs headroom on Pi 5
MemoryMax=3G
CPUWeight=90
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
