[Unit]
Description=Penelope Web UI
After=network.target ollama.service pocketbase.service
Wants=ollama.service pocketbase.service

[Service]
Type=simple
User=pi
WorkingDirectory=AGENT_PROJECT_PATH
Environment=PYTHONUNBUFFERED=1
ExecStart=VENV_PATH/bin/python3 GOLDENIMAGE_PATH/hermes/web_ui.py \
    --soul AGENT_PROJECT_PATH/SOUL.md \
    --chroma-db AGENT_PROJECT_PATH/chroma_db \
    --agent-name "AGENT_NAME" \
    --port 5000
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
